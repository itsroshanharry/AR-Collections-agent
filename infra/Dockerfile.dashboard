# The deployable service: API, dunning workflow and the operator console.
#
# Stage 1: the operator console (frontend/), built to static files. Node is only needed
# here; the runtime image below serves the output from FastAPI.
FROM node:22-slim AS console
WORKDIR /console
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-fund --no-audit
COPY frontend/ ./
RUN npm run build

# Stage 2: the API and dunning workflow. Deliberately excludes the `voice` extra - the
# audio stack pulls in torch and onnxruntime, which do not fit a 512MB free-tier
# instance and are not needed by the API.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Pinned, like everything else in the image: `latest` would change the build under us.
COPY --from=ghcr.io/astral-sh/uv:0.13.8 /uv /usr/local/bin/uv

# --frozen: install exactly what uv.lock says, and fail if it is out of date rather than
# quietly resolving fresh versions into the deploy.
COPY pyproject.toml uv.lock ./
RUN uv sync --extra dashboard --extra data --extra observability --no-dev --frozen

COPY shared/ ./shared/
COPY data/ ./data/
COPY voice_agent/ ./voice_agent/
COPY ab_dashboard/ ./ab_dashboard/
COPY workflow/ ./workflow/
COPY --from=console /console/dist ./frontend/dist/

ENV PYTHONPATH=/app \
    PATH="/app/.venv/bin:$PATH"

# The demo ledger that POST /dunning/sync loads. Generated here rather than copied in:
# it is not committed, and .dockerignore keeps the licence-restricted Kaggle base data
# out of the image, so this uses the built-in distributions. Fixed seed: every build
# produces the same 500 invoices.
RUN python -m data.generate_dataset

# Render injects $PORT; default for local `docker run`.
ENV PORT=8000
EXPOSE 8000

CMD ["sh", "-c", "uvicorn ab_dashboard.main:app --host 0.0.0.0 --port ${PORT}"]
