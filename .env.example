# ---- LLM providers (fallback chain: Groq -> Cerebras -> Ollama) ----
# Groq: https://console.groq.com/keys  (free tier, no card)
GROQ_API_KEY=
# Cerebras: https://cloud.cerebras.ai  (free tier, no card; NOTE: 8K context cap on free tier)
CEREBRAS_API_KEY=
# Optional last-resort local fallback
OLLAMA_BASE_URL=http://localhost:11434/v1

# Model IDs. llama-3.3-70b-versatile / llama-3.1-8b-instant were decommissioned 2026-08-16.
GROQ_MODEL_LARGE=openai/gpt-oss-120b
GROQ_MODEL_SMALL=openai/gpt-oss-20b
CEREBRAS_MODEL_LARGE=gpt-oss-120b

# ---- Voice stack ----
# local  = Groq Whisper STT + Kokoro-FastAPI TTS (free, dev)
# cloud  = Deepgram STT + Aura-2 TTS (deployed; Render has no GPU)
VOICE_PROVIDER=local
KOKORO_BASE_URL=http://localhost:8880/v1
KOKORO_VOICE=af_alloy
DEEPGRAM_API_KEY=

# ---- LiveKit (only needed for room/browser mode; `console` mode needs none of these) ----
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- Access control (all optional locally) ----
# With no keys set, the API and console are fully open: fine on your own machine.
# Set them (any long random string) before exposing the API anywhere. Sent as X-API-Key.
# Operators work the book; admins can also write off debts, start experiments and reset
# the demo. PUBLIC_ROLE is what a visitor without a key gets (viewer, operator or admin).
OPERATOR_API_KEY=
ADMIN_API_KEY=
PUBLIC_ROLE=
# Browser origins allowed to call the API, comma-separated. The console needs none.
CORS_ALLOW_ORIGINS=

# ---- Database ----
# Local dev default is SQLite. Deployed: Neon (always-free) connection string.
# Render's free Postgres is DELETED 30 days after creation - do not use it for this.
DATABASE_URL=sqlite+aiosqlite:///./local.db

# ---- Observability (all optional) ----
# text for terminals, json for log pipelines
LOG_FORMAT=text
LOG_LEVEL=INFO
# Traces to Langfuse (free tier: https://cloud.langfuse.com -> project -> API keys).
# LANGFUSE_HOST: https://cloud.langfuse.com (EU), https://us.cloud.langfuse.com (US), or self-hosted.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Traces to any other OTLP backend (Jaeger from infra/docker-compose.monitoring.yml: http://localhost:4318)
OTEL_EXPORTER_OTLP_ENDPOINT=
# Attach prompt/completion text to LLM spans. Off by default: transcripts contain customer data.
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false
